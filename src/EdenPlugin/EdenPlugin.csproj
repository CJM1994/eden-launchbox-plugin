<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Eden.LaunchBox.Integration</AssemblyName>
    <RootNamespace>EdenLaunchBoxIntegration</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>1.0.1</Version>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    <!-- LaunchBox only runs on Windows; its helper APIs are annotated Windows-only. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- Path to the LaunchBox install whose Core assemblies we compile against (not copied to output). -->
    <LaunchBoxDir Condition="'$(LaunchBoxDir)' == ''">/mnt/c/LaunchBox</LaunchBoxDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Unbroken.LaunchBox.Plugins"><HintPath>$(LaunchBoxDir)/Core/Unbroken.LaunchBox.Plugins.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unbroken.LaunchBox.Windows"><HintPath>$(LaunchBoxDir)/Core/Unbroken.LaunchBox.Windows.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unbroken"><HintPath>$(LaunchBoxDir)/Core/Unbroken.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
